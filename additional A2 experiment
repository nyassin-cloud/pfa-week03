"""Original host-independent topology-preserving fitting algorithms.

No meshes, learned weights, vendor code or third-party implementation are used.
"""
import math


def distance(a, b):
    return math.sqrt(sum((a[i]-b[i])**2 for i in range(3)))


def solve(matrix, rhs):
    """Dense linear solve with scaled coordinates and partial pivoting; multiple RHS."""
    n = len(matrix)
    a = [list(matrix[i])+list(rhs[i]) for i in range(n)]
    width = len(rhs[0])
    for col in range(n):
        pivot = max(range(col,n), key=lambda row:abs(a[row][col]))
        if abs(a[pivot][col]) < 1e-11:
            raise ValueError("Landmarks are coplanar or poorly distributed. Add points on the back and sides.")
        a[col],a[pivot] = a[pivot],a[col]
        factor = a[col][col]
        for j in range(col,n+width): a[col][j] /= factor
        for row in range(n):
            if row == col: continue
            factor = a[row][col]
            for j in range(col,n+width): a[row][j] -= factor*a[col][j]
    return [row[n:] for row in a]


class LandmarkWarp:
    """3D radial basis displacement with an affine polynomial component.

    Uses phi(r)=r, solves original mathematical equations directly. Connectivity
    never changes. This does not guarantee injectivity or prevent foldovers.
    """
    def __init__(self, source, target, regularization=1e-8):
        if len(source)!=len(target) or len(source)<6 or len(source)>128:
            raise ValueError("Use 6–128 paired landmarks")
        if any(len(p)!=3 or not all(math.isfinite(x) for x in p) for p in source+target):
            raise ValueError("Landmarks must be finite 3D coordinates")
        self.center = [sum(p[i] for p in source)/len(source) for i in range(3)]
        self.scale = max(distance(p,self.center) for p in source)
        if self.scale < 1e-9: raise ValueError("Landmarks occupy a single point")
        self.anchors = [[(p[i]-self.center[i])/self.scale for i in range(3)] for p in source]
        n = len(source)
        if any(distance(self.anchors[i],self.anchors[j])<1e-6 for i in range(n) for j in range(i)):
            raise ValueError("Two landmarks use the same template position; choose distinct vertices")
        matrix = [[0.0]*(n+4) for _ in range(n+4)]
        rhs = [[0.0]*3 for _ in range(n+4)]
        for i,p in enumerate(self.anchors):
            for j,q in enumerate(self.anchors): matrix[i][j] = distance(p,q)
            matrix[i][i] += regularization
            for k,value in enumerate([1.0]+p):
                matrix[i][n+k] = matrix[n+k][i] = value
            rhs[i] = [(target[i][k]-source[i][k])/self.scale for k in range(3)]
        self.weights = solve(matrix,rhs)

    def point(self,p):
        q = [(p[i]-self.center[i])/self.scale for i in range(3)]
        basis = [distance(q,a) for a in self.anchors]+[1.0]+q
        return [p[k]+self.scale*sum(b*self.weights[i][k] for i,b in enumerate(basis)) for k in range(3)]


def adjacency(vertex_count, faces):
    result = [set() for _ in range(vertex_count)]
    for face in faces:
        for i,a in enumerate(face):
            b = face[(i+1)%len(face)]
            result[a].add(b); result[b].add(a)
    return result


def protected_band(vertex_count, faces, seeds, rings=2):
    graph = adjacency(vertex_count,faces)
    protected = set(seeds)
    if any(v<0 or v>=vertex_count for v in protected): raise ValueError("Invalid protected vertex")
    frontier = set(protected)
    for _ in range(rings):
        frontier = {j for i in frontier for j in graph[i]}-protected
        protected.update(frontier)
    return protected


def bounded_step(start, goal, maximum):
    if not math.isfinite(maximum) or maximum<0: raise ValueError("Step limit must be nonnegative")
    delta = distance(start,goal)
    scale = min(1.0,maximum/delta) if delta else 0
    return [start[i]+(goal[i]-start[i])*scale for i in range(3)]


def loop_patch(left, right, upper, lower, segments=16, rings=4, expansion=.7):
    """Original quad annulus from four landmarks. A scaffold, not a finished face.

    Parameter directions: angle 0=right, pi/2=upper, pi=left, 3pi/2=lower.
    Ring zero is the opening. Upper and lower curves meet at the corners.
    """
    if segments<8 or segments%4 or not 2<=rings<=12:
        raise ValueError("Use a multiple of four segments (at least 8) and 2–12 rings")
    center = [(left[i]+right[i])/2 for i in range(3)]
    axis = [(right[i]-left[i])/2 for i in range(3)]
    if distance(left,right)<1e-8 or distance(upper,lower)<1e-8:
        raise ValueError("Opening landmarks must be distinct")
    vertices=[]
    for row in range(rings):
        scale=1+expansion*row/(rings-1)
        for col in range(segments):
            angle=2*math.pi*col/segments
            vertical = upper if math.sin(angle)>=0 else lower
            v=[vertical[i]-center[i] for i in range(3)]
            vertices.append([center[i]+scale*(axis[i]*math.cos(angle)+v[i]*abs(math.sin(angle))) for i in range(3)])
    faces=[]
    for row in range(rings-1):
        for col in range(segments):
            nxt=(col+1)%segments
            faces.append([row*segments+col,(row+1)*segments+col,(row+1)*segments+nxt,row*segments+nxt])
    return vertices,faces


