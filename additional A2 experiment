    "knee_L", "knee_R", "ankle_L", "ankle_R", "toe_L", "toe_R",
] + ["extra_%02d" % i for i in range(1,17)]


def helpers():
    return mesh_fn,shape_of,selected_mesh,snapshot,transaction,string_attr


def mesh_data(mesh):
    mesh_fn,*_ = helpers()
    fn=mesh_fn(mesh)
    counts, indices=fn.getVertices()
    faces=[]; cursor=0
    for count in counts:
        faces.append(list(indices[cursor:cursor+count])); cursor+=count
    return fn,[[p.x,p.y,p.z] for p in fn.getPoints(om.MSpace.kWorld)],faces


def require_fit_units():
    # This first Maya integration is qualified for default command/API units.
    # Do not silently rescale a user's scene or claim untested unit conversions.
    if cmds.currentUnit(query=True,linear=True)!="cm":
        raise ValueError("Human fitting currently requires Maya's default centimeter working units. Set Preferences > Settings > Working Units > Linear to centimeter, then retry. Scene units are not changed automatically.")


def signature(mesh):
    fn,_,faces=mesh_data(mesh)
    return hashlib.sha256(json.dumps([fn.numVertices,faces],separators=(",",":")).encode()).hexdigest()


def write_world_points(mesh, points):
    """Undoable bulk Maya tweak update rather than non-undoable MFnMesh.setPoints."""
    mesh_fn,shape_of,*_=helpers()
    fn=mesh_fn(mesh)
    if len(points)!=fn.numVertices: raise ValueError("Fitting changed vertex count unexpectedly")
    inv=fn.dagPath().inclusiveMatrixInverse()
    current=fn.getPoints(om.MSpace.kObject)
    shape=shape_of(mesh)
    # Accumulate any existing tweak rather than assuming zero.
    offsets=cmds.getAttr(shape+".pnts[0:%d]" % (len(points)-1))
    values=[]
    for i,p in enumerate(points):
        local=om.MPoint(*p)*inv
        tweak=offsets[i] if offsets and i<len(offsets) else (0,0,0)
        values.extend([local.x-current[i].x+tweak[0],local.y-current[i].y+tweak[1],local.z-current[i].z+tweak[2]])
    cmds.setAttr(shape+".pnts[0:%d]" % (len(points)-1),*values,type="float3",size=len(points))
    updated=mesh_fn(mesh).getPoints(om.MSpace.kWorld)
    tolerance=max(1e-6,max(abs(x) for p in points for x in p)*1e-6)
    if any(distance([a.x,a.y,a.z],b)>tolerance for a,b in zip(updated,points)):
        raise RuntimeError("Maya vertex update did not match requested positions; operation rolled back")


