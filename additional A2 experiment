def action_text(label, name):
    if name in ACTIONS: return ACTIONS[name]
    if "documentation" in label.lower(): return "Opens the official documentation in your browser. No scene changes or purchases. Return to Maya to continue."
    if "UV Editor" in label: return "Opens Maya's UV Editor. Select the working mesh, display a checker and inspect overlap and seam placement."
    if label.startswith("Analyze"): return "Reads the indicated mesh and writes defect counts to the log. Repair defects before proceeding. This does not alter the mesh or certify deformation quality."
    if "live" in label.lower(): return "A live Source is a snapping surface for Maya Quad Draw. Enable it for manual retopology, then disable it when you finish to restore normal selection."
    if "vendor tool" in label: return "Selects the current working mesh. Run your separately installed vendor shelf tool next, then select its result and Set working mesh."
    return label+". Follow the numbered steps on this page. See the page guide for prerequisites and expected results."


