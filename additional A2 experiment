    def create_original_head(self):
        require_fit_units()
        _,_,_,_,transaction,string_attr=helpers()
        source=self.source()
        vertices,faces,landmarks,_=make_head()
        # Align authored geometry uniformly to the head-only Source bounding box.
        box=cmds.exactWorldBoundingBox(source)
        lo=[min(p[i] for p in vertices) for i in range(3)]
        hi=[max(p[i] for p in vertices) for i in range(3)]
        factor=(box[4]-box[1])/(hi[1]-lo[1])
        if factor<=0: raise ValueError("Head Source needs nonzero height")
        center=[(box[i]+box[i+3])/2 for i in range(3)]
        origin=[(lo[i]+hi[i])/2 for i in range(3)]
        aligned=[[center[i]+(p[i]-origin[i])*factor for i in range(3)] for p in vertices]
        # OBJ is a temporary serialization of our own generated arrays, not an external asset.
        path=None
        try:
            with tempfile.NamedTemporaryFile(mode="w",suffix=".obj",delete=False,encoding="utf-8") as stream:
                stream.write(obj_text(aligned,faces)); path=stream.name
            with transaction("CW original head template"):
                nodes=cmds.file(path,i=True,type="OBJ",returnNewNodes=True,ignoreVersion=True,
                                namespace="CW_originalHead",mergeNamespacesOnClash=False)
                shapes=cmds.ls(nodes,type="mesh",long=True) or []
                if len(shapes)!=1: raise RuntimeError("Original template import did not produce one mesh")
                mesh=cmds.listRelatives(shapes[0],parent=True,fullPath=True)[0]
                _,actual,imported_faces=mesh_data(mesh)
                if imported_faces!=faces or len(actual)!=len(aligned) or any(distance(a,b)>max(1e-5,factor*1e-5) for a,b in zip(actual,aligned)):
                    raise RuntimeError("OBJ importer changed template order/units; cannot safely prefill landmarks")
                string_attr(mesh,"cwOriginalAsset","Procedurally authored by Creature Workbench; no external mesh")
                string_attr(mesh,"cwReadiness","ORIGINAL_CONSTRUCTION_TEMPLATE_NOT_DEFORMATION_VALIDATED")
        finally:
            if path and os.path.exists(path): os.remove(path)
        self.remember(mesh,"template")
        sig=signature(mesh)
        self.fit_pairs={name:{"template":dict(index=index,uuid=self.template_uuid,signature=sig)} for name,index in landmarks.items()}
        cmds.text(self.ui["template_label"],edit=True,label="Original head template: "+mesh.split("|")[-1])
        cmds.select(mesh)
        self.log("Original connected head created: %d quads. %d template landmarks prefilled. Capture matching Source landmarks; use a head-only Source. No external asset used." % (len(faces),len(landmarks)))

    def set_template(self):
        _,_,selected_mesh,_,_,_=helpers()
        mesh=selected_mesh()
        if cmds.ls(mesh,uuid=True)[0]==self.source_uuid:
            raise ValueError("Template and Source must be separate objects")
        self.remember(mesh,"template")
        self.fit_pairs={}
        cmds.text(self.ui["template_label"],edit=True,label="Template: "+mesh.split("|")[-1])
        self.log("Your template assigned. Its loop quality determines the output connectivity.")

    def align_template(self):
        require_fit_units()
        _,_,_,snapshot,transaction,_=helpers()
        src=self.source(); template=self.resolve("template")
        a=cmds.exactWorldBoundingBox(template); b=cmds.exactWorldBoundingBox(src)
        if a[4]-a[1]<1e-9: raise ValueError("Template has no height")
        factor=(b[4]-b[1])/(a[4]-a[1])
        ca=[(a[i]+a[i+3])/2 for i in range(3)]; cb=[(b[i]+b[i+3])/2 for i in range(3)]
        with transaction("CW align owned template"):
            result=snapshot(template,"_alignedTemplate")
            _,points,_=mesh_data(result)
            write_world_points(result,[[cb[i]+(p[i]-ca[i])*factor for i in range(3)] for p in points])
        self.remember(result,"template"); self.fit_pairs={}
        cmds.text(self.ui["template_label"],edit=True,label="Template: "+result.split("|")[-1])
        cmds.select(result)
        self.log("Roughly aligned copy made. Match orientation/pose in the viewport before pairing features.")

    def captured_vertex(self,slot):
        _,shape_of,*_=helpers()
        selected=cmds.filterExpand(cmds.ls(selection=True,long=True,flatten=True) or [],selectionMask=31) or []
        if len(selected)!=1: raise ValueError("Select exactly ONE vertex on the "+slot+" mesh")
        match=re.match(r"(.+)\.vtx\[(\d+)\]$",selected[0])
        mesh=self.resolve(slot)
        if not match or shape_of(match.group(1))!=shape_of(mesh):
            raise ValueError("The selected vertex is not on the assigned "+slot)
        return dict(index=int(match.group(2)),uuid=cmds.ls(mesh,uuid=True)[0],signature=signature(mesh))

    def capture_landmark(self,slot):
        label=self.value("fit_landmark","menu")
        self.fit_pairs.setdefault(label,{})[slot]=self.captured_vertex(slot)
        self.log(label+": captured "+slot+" vertex. "+("Pair complete." if len(self.fit_pairs[label])==2 else "Capture the matching other vertex next."))

    def show_template_landmark(self):
        label=self.value("fit_landmark","menu")
        entry=self.fit_pairs.get(label,{}).get("template")
        mesh=self.resolve("template")
        if not entry: raise ValueError("Capture this template point first, or choose a prefilled point")
        if entry["uuid"]!=self.template_uuid or entry["signature"]!=signature(mesh):
            raise ValueError("Template changed; recapture its landmarks")
        cmds.select(mesh+".vtx[%d]" % entry["index"],replace=True)
        self.log("Highlighted Template "+label+". Match this feature on Source.")

    def next_landmark(self):
        current=LANDMARKS.index(self.value("fit_landmark","menu"))
        for offset in range(1,len(LANDMARKS)+1):
            label=LANDMARKS[(current+offset)%len(LANDMARKS)]
            if len(self.fit_pairs.get(label,{}))<2:
                cmds.optionMenu(self.ui["fit_landmark"],edit=True,value=label); return
        self.log("All landmark slots have complete pairs.")

    def clear_landmark(self):
        label=self.value("fit_landmark","menu")
        self.fit_pairs.pop(label,None); self.log("Cleared "+label)

    def show_landmarks(self):
        self.log("\n".join("%s: template %s / source %s" % (key,pair.get("template",{}).get("index","—"),pair.get("source",{}).get("index","—")) for key,pair in self.fit_pairs.items()) or "No landmarks captured yet.")

    def correspondence(self,complete=True):
        template=self.resolve("template"); source=self.source()
        meshes={"template":template,"source":source}
        points={slot:mesh_data(mesh)[1] for slot,mesh in meshes.items()}
        signatures={slot:signature(mesh) for slot,mesh in meshes.items()}
        uids={slot:cmds.ls(mesh,uuid=True)[0] for slot,mesh in meshes.items()}
        pairs=[]
        for label,pair in self.fit_pairs.items():
            if complete and len(pair)!=2: continue
            resolved={}
            for slot,entry in pair.items():
                if entry["uuid"]!=uids[slot] or entry["signature"]!=signatures[slot]:
                    raise ValueError("Mesh topology/assignment changed; recapture landmarks")
                resolved[slot]=points[slot][entry["index"]]
            pairs.append((label,resolved,pair))
        return pairs

    def fit_human(self):
        require_fit_units()
        self.require_rest()
        _,_,_,snapshot,transaction,string_attr=helpers()
        template=self.resolve("template")
        pairs=self.correspondence()
        warp=LandmarkWarp([p["template"] for _,p,_ in pairs],[p["source"] for _,p,_ in pairs])
        _,points,faces=mesh_data(template)
        warped=[warp.point(p) for p in points]
        if not all(math.isfinite(x) for p in warped for x in p): raise ValueError("Invalid fit; inspect landmarks")
        seeds=[indices["template"]["index"] for label,_,indices in pairs if label.startswith(("eye_","mouth","nose_"))]
        # Keep all open boundaries fixed during the optional subsequent projection.
        edge_counts={}
        for face in faces:
            for i,a in enumerate(face):
                edge=tuple(sorted((a,face[(i+1)%len(face)])))
                edge_counts[edge]=edge_counts.get(edge,0)+1
        seeds+=list({i for edge,count in edge_counts.items() if count==1 for i in edge})
        protected=sorted(protected_band(len(points),faces,seeds,self.value("fit_band")))
        with transaction("CW human topology fit"):
            result=snapshot(template,"_humanFit")
            write_world_points(result,warped)
            string_attr(result,"cwFitSignature",signature(template))
            string_attr(result,"cwFitProtected",json.dumps(protected))
            string_attr(result,"cwFitSourceUUID",self.source_uuid)
            string_attr(result,"cwFitLandmarks",json.dumps({label:idx["template"]["index"] for label,_,idx in pairs}))
            string_attr(result,"cwReadiness","UNREVIEWED_FIT")
        self.remember(result,"target"); cmds.select(result)
        self.log("Human fit created: %d vertices, %d faces; template connectivity preserved. Inspect lips, lids, fingers and joint loops before rigging." % (len(points),len(faces)))

    def fit_protected(self,mesh):
        if not cmds.attributeQuery("cwFitSignature",node=mesh,exists=True):
            raise ValueError("Use a Human topology fitted output first")
        if cmds.getAttr(mesh+".cwFitSignature")!=signature(mesh):
            raise ValueError("Output topology changed; protected vertex IDs are no longer valid")
        if cmds.getAttr(mesh+".cwFitSourceUUID")!=self.source_uuid:
            raise ValueError("Source changed since fitting. Restore the original Source or create a new fit")
        return set(json.loads(cmds.getAttr(mesh+".cwFitProtected")))

    def protect_fit_vertices(self):
        _,shape_of,_,_,transaction,string_attr=helpers()
        mesh=self.target(); protected=self.fit_protected(mesh)
        selected=cmds.filterExpand(cmds.ls(selection=True,long=True,flatten=True) or [],selectionMask=31) or []
        if not selected: raise ValueError("Select working-mesh vertices to protect")
        seeds=[]
        for item in selected:
            node,index=item.split(".vtx[")
            if shape_of(node)!=shape_of(mesh): raise ValueError("Select vertices on the working mesh only")
            seeds.append(int(index[:-1]))
        fn,_,faces=mesh_data(mesh)
        protected.update(protected_band(fn.numVertices,faces,seeds,self.value("fit_band")))
        with transaction("CW protect fit vertices"):
            string_attr(mesh,"cwFitProtected",json.dumps(sorted(protected)))
        self.log("Protected %d vertices from surface refinement." % len(protected))

    def select_protected(self):
        mesh=self.target(); vertices=self.fit_protected(mesh)
        cmds.select([mesh+".vtx[%d]" % i for i in vertices],replace=True)

    def refine_human(self):
        require_fit_units()
        mesh_fn,_,_,snapshot,transaction,string_attr=helpers()
        mesh=self.target(); protected=self.fit_protected(mesh)
        sourcefn=mesh_fn(self.source())
        fn,points,_=mesh_data(mesh)
        normals=fn.getVertexNormals(True,om.MSpace.kWorld)
        box=cmds.exactWorldBoundingBox(mesh)
        step=(box[4]-box[1])*self.value("fit_distance","float")/100
        if step<=0: raise ValueError("Working mesh has no height")
        skipped=set()
        for _ in range(self.value("fit_steps")):
            for i,p in enumerate(points):
                if i in protected: continue
                closest,normal,_=sourcefn.getClosestPointAndNormal(om.MPoint(*p),om.MSpace.kWorld)
                goal=[closest.x,closest.y,closest.z]
                if distance(p,goal)>step*10 or normals[i]*normal<.25:
                    skipped.add(i); continue
                points[i]=bounded_step(p,goal,step)
        with transaction("CW bounded human fit"):
            result=snapshot(mesh,"_refined")
            write_world_points(result,points)
            string_attr(result,"cwReadiness","UNREVIEWED_FIT")
        self.remember(result,"target"); cmds.select(result)
        self.log("Refined copy; %d protected, %d distant/opposite-facing vertices skipped. Check openings and intersections." % (len(protected),len(skipped)))

    def check_human(self):
        mesh=self.target(); protected=self.fit_protected(mesh)
        _,points,faces=mesh_data(mesh)
        _,original,template_faces=mesh_data(self.resolve("template"))
        same=faces==template_faces and len(points)==len(original)
        ratios=[]
        if same:
            edges={tuple(sorted((a,face[(i+1)%len(face)]))) for face in faces for i,a in enumerate(face)}
            for a,b in edges:
                base=distance(original[a],original[b])
                if base>1e-10: ratios.append(distance(points[a],points[b])/base)
        report=geometry_report(mesh)
        report.update(template_connectivity_preserved=same,protected_vertices=len(protected),
                      edge_scale_min=min(ratios) if ratios else None,edge_scale_max=max(ratios) if ratios else None,
                      readiness="REQUIRES_DEFORMATION_REVIEW",self_intersections="NOT_TESTED",
                      required_review=["blink/lid contact","lip closure","jaw opening","smile/pucker","shoulder/hip bends","elbow/knee compression","finger curl"])
        self.last_report=report; self.log(json.dumps(report,indent=2))

    def build_loop_patch(self,feature):
        require_fit_units()
        _,_,_,_,transaction,string_attr=helpers()
        # SOURCE-only captures are enough; no template asset is needed for this helper.
        fn,_,_=mesh_data(self.source())
        sourcepoints=fn.getPoints(om.MSpace.kWorld)
        sig=signature(self.source())
        keys=([feature+"_outer",feature+"_inner",feature+"_upper",feature+"_lower"]
              if feature.startswith("eye") else ["mouth_L","mouth_R","mouth_upper","mouth_lower"])
        points=[]
        for key in keys:
            entry=self.fit_pairs.get(key,{}).get("source")
            if not entry or entry["uuid"]!=self.source_uuid or entry["signature"]!=sig:
                raise ValueError("Capture SOURCE landmark "+key+" first")
            p=sourcepoints[entry["index"]]; points.append([p.x,p.y,p.z])
        # Order world-X endpoints to give the same face orientation on both eyes.
        if points[0][0]>points[1][0]: points[0],points[1]=points[1],points[0]
        verts,faces=loop_patch(*points,segments=self.value("patch_segments"),rings=self.value("patch_rings"))
        with transaction("CW original facial loop patch"):
            # polyCreateFacet creates undoable geometry; polyUnite merges construction
            # pieces and polyMergeVertex welds only coincident points at tiny tolerance.
            pieces=[cmds.polyCreateFacet(point=[verts[v] for v in face],constructionHistory=False)[0] for face in faces]
            patch=cmds.polyUnite(pieces,constructionHistory=False,name="CW_"+feature+"_LOOP_PATCH#")[0]
            cmds.polyMergeVertex(patch+".vtx[*]",distance=1e-8,alwaysMergeTwoVertices=False,constructionHistory=False)
            string_attr(patch,"cwReadiness","OPEN_CONSTRUCTION_PATCH_NOT_COMPLETE_FACE")
        cmds.select(patch)
        self.log("Original open loop patch created. Join/refine it into a complete face; it is not the active working output.")


