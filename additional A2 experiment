"""Original procedural head topology, authored for this tool. No external asset.

This is a neutral construction template with deliberate eye/lip rings. It is
not a sculpted production head, a facial rig, or deformation-certified geometry.
"""
import math


def make_head(ring_rows=4):
    if not isinstance(ring_rows,int) or not 2<=ring_rows<=12:
        raise ValueError("Use 2–12 facial ring rows")
    n=16
    verts=[]; faces=[]; grid={}; uvcoord={}
    def position(u,v,z=1):
        length=math.sqrt(u*u+v*v+z*z)
        jaw=1-.14*max(0,-v)
        x=.82*u/length*jaw
        y=1.1*v/length
        depth=.76*z/length
        if z>0:
            depth+=.22*math.exp(-(u/.18)**2-((v-.06)/.25)**2)
        return [x,y,depth]
    def add(p):
        verts.append(p); return len(verts)-1
    def perimeter(x0,y0,x1,y1):
        return ([(x,y0) for x in range(x0,x1)]+[(x1,y) for y in range(y0,y1)]
                +[(x,y1) for x in range(x1,x0,-1)]+[(x0,y) for y in range(y1,y0,-1)])
    holes={"eye_R":(2,10,6,13),"eye_L":(10,10,14,13),"mouth":(5,4,11,6)}
    for j in range(n+1):
        for i in range(n+1):
            if any(x0<i<x1 and y0<j<y1 for x0,y0,x1,y1 in holes.values()): continue
            u,v=2*i/n-1,2*j/n-1
            grid[i,j]=add(position(u,v)); uvcoord[i,j]=(u,v)
    for j in range(n):
        for i in range(n):
            if any(x0<=i<x1 and y0<=j<y1 for x0,y0,x1,y1 in holes.values()): continue
            faces.append([grid[i,j],grid[i+1,j],grid[i+1,j+1],grid[i,j+1]])
    rings={}
    landmarks={}
    for name,(x0,y0,x1,y1) in holes.items():
        loop=perimeter(x0,y0,x1,y1)
        outer=[grid[p] for p in loop]
        cx,cy=(x0+x1)/2,(y0+y1)/2
        hx,hy=(x1-x0)/2,(y1-y0)/2
        angles=[math.atan2((j-cy)/hy,(i-cx)/hx) for i,j in loop]
        rings[name]=[outer]
        for row in range(1,ring_rows+1):
            t=row/ring_rows
            current=[]
            for (i,j),angle in zip(loop,angles):
                # Interpolate a rectangle perimeter into an elliptical opening.
                endx=cx+hx*.72*math.cos(angle)
                endy=cy+hy*(.45 if name=="mouth" else .56)*math.sin(angle)
                u=2*((1-t)*i+t*endx)/n-1
                v=2*((1-t)*j+t*endy)/n-1
                current.append(add(position(u,v)))
            for k in range(len(outer)):
                nxt=(k+1)%len(outer)
                faces.append([outer[k],outer[nxt],current[nxt],current[k]])
            rings[name].append(current)
            outer=current
        points=[verts[i] for i in outer]
        right=outer[max(range(len(outer)),key=lambda k:points[k][0])]
        left=outer[min(range(len(outer)),key=lambda k:points[k][0])]
        upper=outer[max(range(len(outer)),key=lambda k:points[k][1])]
        lower=outer[min(range(len(outer)),key=lambda k:points[k][1])]
        if name=="mouth":
            landmarks.update(mouth_L=right,mouth_R=left,mouth_upper=upper,mouth_lower=lower)
        else:
            landmarks[name+"_inner"]=left if name=="eye_L" else right
            landmarks[name+"_outer"]=right if name=="eye_L" else left
            landmarks[name+"_upper"]=upper; landmarks[name+"_lower"]=lower
        # Inset rim provides depth; remains open. No eyeball or mouth bag supplied.
        inset=[add([verts[idx][0],verts[idx][1],verts[idx][2]-.035]) for idx in outer]
        for k in range(len(outer)):
            nxt=(k+1)%len(outer)
            faces.append([outer[k],outer[nxt],inset[nxt],inset[k]])
        rings[name].append(inset)
    boundary=perimeter(0,0,n,n)
    front=[grid[p] for p in boundary]
    side_loops=[]
    for z in (.33,-.33,-1):
        back=[add(position(2*i/n-1,2*j/n-1,z)) for i,j in boundary]
        for k in range(len(front)):
            nxt=(k+1)%len(front)
            # Opposite winding to front patch along the shared edge.
            faces.append([front[nxt],front[k],back[k],back[nxt]])
        front=back; side_loops.append(back)
    backgrid=dict(zip(boundary,front))
    for j in range(1,n):
        for i in range(1,n): backgrid[i,j]=add(position(2*i/n-1,2*j/n-1,-1))
    for j in range(n):
        for i in range(n):
            faces.append([backgrid[i,j+1],backgrid[i+1,j+1],backgrid[i+1,j],backgrid[i,j]])
    landmarks.update(nose_tip=grid[8,9],nose_base=grid[8,7],chin=grid[8,1],forehead=grid[8,15],
                     head_back=backgrid[8,8],jaw_L=grid[15,3],jaw_R=grid[1,3])
    for side,x in (("L",n),("R",0)):
        landmarks["ear_"+side]=side_loops[0][boundary.index((x,8))]
    return verts,faces,landmarks,rings


def obj_text(vertices,faces):
    lines=["# Original procedural Creature Workbench head. Construction template, not certified for animation."]
    lines += ["v %.9g %.9g %.9g" % tuple(p) for p in vertices]
    lines += ["f "+" ".join(str(i+1) for i in face) for face in faces]
    return "\n".join(lines)+"\n"


