def shape_of(mesh):
    if not cmds.objExists(mesh):
        raise ValueError("Object no longer exists: " + mesh)
    if cmds.nodeType(mesh) == "mesh":
        return cmds.ls(mesh, long=True)[0]
    shapes = cmds.listRelatives(mesh, shapes=True, noIntermediate=True, fullPath=True, type="mesh") or []
    if len(shapes) != 1:
        raise ValueError("Choose a transform containing exactly one polygon mesh")
    return shapes[0]


def mesh_fn(mesh):
    selection = om.MSelectionList()
    selection.add(shape_of(mesh))
    return om.MFnMesh(selection.getDagPath(0))


def selected_mesh():
    selected = cmds.ls(selection=True, objectsOnly=True, long=True) or []
    selected = list(dict.fromkeys(selected))
    if len(selected) != 1:
        raise ValueError("Select exactly one mesh")
    shape = shape_of(selected[0])
    return cmds.listRelatives(shape, parent=True, fullPath=True)[0]


def skin_of(mesh):
    skins = cmds.ls(cmds.listHistory(shape_of(mesh)) or [], type="skinCluster") or []
    if len(skins) > 1:
        raise ValueError("Multiple skinClusters found; choose a mesh with one skinCluster")
    return skins[0] if skins else None


def string_attr(node, name, value):
    if not cmds.attributeQuery(name, node=node, exists=True):
        cmds.addAttr(node, longName=name, dataType="string")
    cmds.setAttr(node+"."+name, value, type="string")


@contextmanager
def transaction(name):
    """Rollback only this chunk; marker guarantees there is an undoable action."""
    if not cmds.undoInfo(query=True, state=True):
        raise RuntimeError("Enable Maya Undo before running scene operations")
    selection = cmds.ls(selection=True, long=True) or []
    cmds.undoInfo(openChunk=True, chunkName=name)
    marker = cmds.createNode("network", name="CW_transaction#")
    try:
        yield
        cmds.delete(marker)
    except Exception:
        cmds.undoInfo(closeChunk=True)
        cmds.undo()
        existing = [item for item in selection if cmds.objExists(item)]
        if existing:
            cmds.select(existing, replace=True)
        raise
    else:
        cmds.undoInfo(closeChunk=True)


def snapshot(mesh, suffix):
    """Duplicate evaluated geometry only; never copy source hierarchy or deformers."""
    if cmds.listRelatives(mesh, children=True, type="transform"):
        raise ValueError("Use a mesh transform without child transforms")
    result = cmds.duplicate(mesh, returnRootsOnly=True, inputConnections=False,
                            upstreamNodes=False, name=safe_name(mesh.split("|")[-1])+suffix)[0]
    if cmds.listRelatives(result, parent=True):
        result = cmds.parent(result, world=True)[0]
    cmds.delete(result, constructionHistory=True)
    for shape in cmds.listRelatives(result, shapes=True, fullPath=True) or []:
        if cmds.getAttr(shape+".intermediateObject"):
            cmds.delete(shape)
    for attr in ("tx","ty","tz","rx","ry","rz","sx","sy","sz","v"):
        cmds.setAttr(result+"."+attr, lock=False)
    cmds.setAttr(result+".visibility", True)
    string_attr(result, "cwSource", mesh)
    return cmds.ls(result, long=True)[0]


def geometry_report(mesh):
    fn = mesh_fn(mesh)
    path = fn.dagPath()
    counts, _ = fn.getVertices()
    edges = om.MItMeshEdge(path)
    boundaries = 0
    while not edges.isDone():
        boundaries += int(edges.onBoundary())
        edges.next()
    faces = om.MItMeshPolygon(path)
    degenerate = []
    while not faces.isDone():
        if faces.getArea(om.MSpace.kWorld) <= 1e-12:
            degenerate.append(faces.index())
        faces.next()
    nm_e = cmds.polyInfo(mesh, nonManifoldEdges=True) or []
    nm_v = cmds.polyInfo(mesh, nonManifoldVertices=True) or []
    lamina = cmds.polyInfo(mesh, laminaFaces=True) or []
    return dict(mesh=mesh, vertices=fn.numVertices, edges=fn.numEdges, faces=fn.numPolygons,
                quad_percent=round(100*sum(c == 4 for c in counts)/max(1,len(counts)),2),
                triangles=sum(c == 3 for c in counts), ngons=sum(c > 4 for c in counts),
                boundary_edges=boundaries, nonmanifold_edges=len(nm_e),
                nonmanifold_vertices=len(nm_v), lamina_faces=len(lamina),
                zero_area_faces=len(degenerate), uv_sets=fn.getUVSetNames(),
                skin=skin_of(mesh), units=cmds.currentUnit(query=True, linear=True),
                note="Boundary edges can be intentional. Counts do not certify animation edge flow.")


def uv_report(mesh):
    fn = mesh_fn(mesh)
    uvset = fn.currentUVSetName()
    us, vs = fn.getUVs(uvset)
    if not us:
        raise ValueError("No UV coordinates in current UV set")
    missing, flipped, zero, ratios = [], [], [], []
    faces = om.MItMeshPolygon(fn.dagPath())
    while not faces.isDone():
        idx = faces.index()
        try:
            u, v = faces.getUVs(uvset)
            area = uv_area(list(zip(u,v)))
            world = faces.getArea(om.MSpace.kWorld)
            if area < -1e-12:
                flipped.append(idx)
            if abs(area) < 1e-12:
                zero.append(idx)
            if world > 1e-12:
                ratios.append(abs(area)/world)
        except RuntimeError:
            missing.append(idx)
        faces.next()
    ratios.sort()
    median = ratios[len(ratios)//2] if ratios else 0
    spread = (ratios[int((len(ratios)-1)*.95)]/max(1e-15,ratios[int((len(ratios)-1)*.05)])) if ratios else None
    return dict(mesh=mesh, uv_set=uvset, uv_count=len(us),
                missing_uv_faces=len(missing), negative_signed_uv_faces=len(flipped),
                zero_area_uv_faces=len(zero), uv_bounds=[min(us),min(vs),max(us),max(vs)],
                area_density_p95_over_p05=spread, median_uv_area_per_world_area=median,
                note="Area-density spread is not angular stretch. Negative UV orientation may be deliberate. Use UV Editor overlap selection for overlap testing.")


