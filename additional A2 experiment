"""Host-independent guide generation and UV measurements. Y up, +Z forward."""
import math
import re

PRESETS = {"Human / biped": 1, "Quadruped": 2, "Hexapod": 3,
           "Octopod / spider": 4, "Winged quadruped": 2,
           "Serpentine": 0, "Custom multi-leg": 4}


def safe_name(value):
    value = re.sub(r"[^A-Za-z0-9_]", "_", value.strip()) or "Creature"
    return ("C_" + value) if value[0].isdigit() else value


def guide_spec(preset, bounds, pairs=4, spine_count=4, tail_count=5, digits=0):
    """Return ordered joints with parent keys. These are templates, not anatomy detection."""
    if preset not in PRESETS:
        raise ValueError("Unknown creature preset")
    if len(bounds) != 6 or not all(math.isfinite(v) for v in bounds):
        raise ValueError("Invalid bounding box")
    lo, hi = bounds[:3], bounds[3:]
    if any(hi[i] <= lo[i] for i in range(3)):
        raise ValueError("Mesh needs nonzero volume in all three axes")
    spine_count, tail_count, digits = int(spine_count), int(tail_count), int(digits)
    if not 2 <= spine_count <= 16 or not 0 <= tail_count <= 32 or not 0 <= digits <= 5:
        raise ValueError("Guide counts out of range")
    pairs = int(pairs) if preset == "Custom multi-leg" else PRESETS[preset]
    if not 0 <= pairs <= 12:
        raise ValueError("Leg pairs must be 0..12")
    cx = (lo[0] + hi[0]) / 2
    w, h, d = [hi[i] - lo[i] for i in range(3)]
    def p(x, y, z):
        return [cx + x*w, lo[1] + y*h, lo[2] + z*d]
    out = []
    def add(key, parent, pos, chain="body", role="fk"):
        out.append(dict(key=key, parent=parent, position=pos, chain=chain, role=role))
        return key
    human = preset == "Human / biped"
    root = add("pelvis", None, p(0, .52 if human else .58, .48 if human else .25))
    parent = root
    for i in range(1, spine_count):
        t = i/(spine_count-1)
        parent = add("spine_%02d" % i, parent,
                     p(0, .52+.29*t if human else .58, .48 if human else .25+.48*t))
    chest = parent
    neck = add("neck", chest, p(0, .86 if human else .72, .5 if human else .84))
    head = add("head", neck, p(0, .94 if human else .8, .52 if human else .93))
    add("head_tip", head, p(0, .99 if human else .8, .55 if human else 1), role="end")
    for pair in range(pairs):
        t = pair/max(1, pairs-1)
        attach = root if pair == 0 else chest
        z = .5 if human else .25+.48*t
        for sign, side in [(1, "L"), (-1, "R")]:
            chain = "leg_%02d_%s" % (pair+1, side)
            a = add(chain+"_upper", attach, p(sign*.13, .5 if human else .57, z), chain, "ik_start")
            b = add(chain+"_lower", a, p(sign*(.14 if human else .35), .28, z+.10), chain, "ik_mid")
            c = add(chain+"_ankle", b, p(sign*(.14 if human else .46), .06, z), chain, "ik_end")
            add(chain+"_toe", c, p(sign*(.14 if human else .46), .02, min(.99,z+.13)), chain, "end")
    if human:
        for sign, side in [(1,"L"),(-1,"R")]:
            chain = "arm_"+side
            a = add(chain+"_upper", chest, p(sign*.13,.8,.48), chain)
            b = add(chain+"_lower", a, p(sign*.30,.79,.44), chain)
            hand = add(chain+"_hand", b, p(sign*.43,.78,.48), chain)
            for digit in range(digits):
                parent = hand
                for j in range(3):
                    parent = add("finger_%d_%d_%s" % (digit+1,j+1,side), parent,
                                 p(sign*(.45+j*.02),.78,(.30+digit*.09)), chain)
    if preset == "Winged quadruped":
        for sign, side in [(1,"L"),(-1,"R")]:
            parent = chest
            for i in range(3):
                parent = add("wing_%d_%s" % (i+1,side), parent,
                             p(sign*(.13+i*.18),.7+i*.12,.7-i*.14), "wing_"+side)
    parent = root
    for i in range(tail_count):
        t = (i+1)/max(1,tail_count)
        parent = add("tail_%02d" % (i+1), parent,
                     p(0,.55-.25*t,.25-.45*t), "tail")
    return out


def pole_position(a, b, c, distance):
    ab = [b[i]-a[i] for i in range(3)]
    ac = [c[i]-a[i] for i in range(3)]
    norm = sum(v*v for v in ac)
    if norm < 1e-16:
        raise ValueError("Limb endpoints overlap")
    projection = sum(ab[i]*ac[i] for i in range(3))/norm
    direction = [ab[i]-projection*ac[i] for i in range(3)]
    length = math.sqrt(sum(v*v for v in direction))
    if length < 1e-8:
        raise ValueError("Bend the middle limb guide slightly before building IK")
    return [b[i]+direction[i]*distance/length for i in range(3)]


def uv_area(points):
    return .5*sum(points[i][0]*points[(i+1)%len(points)][1]
                   - points[(i+1)%len(points)][0]*points[i][1] for i in range(len(points)))


def validate_spec(spec):
    seen = set()
    for entry in spec:
        if entry["key"] in seen or (entry["parent"] is not None and entry["parent"] not in seen):
            raise ValueError("Guide hierarchy is not an ordered tree")
        if len(entry["position"]) != 3 or not all(math.isfinite(v) for v in entry["position"]):
            raise ValueError("Invalid guide position")
        seen.add(entry["key"])
    if not spec or sum(x["parent"] is None for x in spec) != 1:
        raise ValueError("Exactly one root required")
    return True


