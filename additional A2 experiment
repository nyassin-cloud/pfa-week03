        cmds.text(label="HELP — ? explains an action without running it",align="left")
        self.ui["help_text"]=cmds.scrollField(editable=False,wordWrap=True,height=125,text=PAGES["Start here"])
        cmds.text(label="RESULTS / ERRORS",align="left")
        self.ui["log"] = cmds.scrollField(editable=False, wordWrap=True, height=75,
                                          text="Ready. Set a source mesh to begin.")
        cmds.showWindow(win)
        self.search_help()
        self.log("Maya " + cmds.about(version=True) + " | Tool " + VERSION)

    def remember(self, node, slot):
        setattr(self, slot+"_uuid", cmds.ls(node, uuid=True)[0])
        if slot in ("source","target"):
            cmds.text(self.ui[slot+"_label"], edit=True, label=slot.title()+": "+node.split("|")[-1])

    def resolve(self, slot):
        uid = getattr(self,slot+"_uuid")
        found = cmds.ls(uid, long=True) if uid else []
        if not found:
            raise ValueError("Set a valid " + slot + " first")
        return found[0]

    def source(self):
        return self.resolve("source")

    def target(self):
        mesh = self.resolve("target")
        if self.source_uuid == self.target_uuid:
            raise ValueError("Working mesh must be a separate copy from Source")
        return mesh

    def set_source(self):
        self.remember(selected_mesh(),"source")
        self.fit_pairs={}
        self.log("Source set. Re-check the rest-pose checkbox for this source.")
        cmds.checkBox(self.ui["rest"], edit=True, value=False)

    def set_target(self):
        mesh = selected_mesh()
        if cmds.ls(mesh, uuid=True)[0] == self.source_uuid:
            raise ValueError("Source and working mesh must be different objects")
        self.remember(mesh,"target")

    def require_rest(self):
        if not self.value("rest","bool"):
            raise ValueError("Verify the source bind/rest pose, then tick the checkbox in Free / Built-in")

    def make_working(self):
        self.require_rest()
        with transaction("CW snapshot"):
            result = snapshot(self.source(),"_work")
        self.remember(result,"target")
        cmds.select(result)
        self.log("Created independent working snapshot: "+result)

    def analyze(self, source):
        self.last_report = geometry_report(self.source() if source else self.target())
        self.log(json.dumps(self.last_report,indent=2))

    def retopo(self):
        self.require_rest()
        source = self.source()
        report = geometry_report(source)
        if any(report[k] for k in ("nonmanifold_edges","nonmanifold_vertices","lamina_faces","zero_area_faces")):
            raise ValueError("Repair non-manifold, lamina and zero-area geometry before retopology. Analyze source for counts.")
        if not hasattr(cmds,"polyRetopo"):
            raise RuntimeError("This Maya build does not expose polyRetopo")
        self.log("Native remesh starting; Maya may be busy until its solver returns.")
        with transaction("CW retopology"):
            result = snapshot(source,"_retopo")
            cmds.select(result,replace=True)
            nodes = cmds.polyRetopo(result)
            if isinstance(nodes,str):
                nodes = [nodes]
            history = cmds.ls(cmds.listHistory(result) or [],type="polyRetopo") or []
            node = history[0] if history else next((n for n in (nodes or []) if cmds.nodeType(n)=="polyRetopo"),None)
            if not node:
                raise RuntimeError("Retopologize did not create a polyRetopo history node")
            settings = {"targetFaceCount":self.value("faces"),
                        "targetFaceCountTolerance":self.value("tolerance"),
                        "topologyRegularity":self.value("regularity","float"),
                        "faceUniformity":self.value("uniformity","float"),
                        "anisotropy":self.value("anisotropy","float"),
                        "preserveHardEdges":self.value("hard","bool")}
            for attr,value in settings.items():
                if not cmds.attributeQuery(attr,node=node,exists=True):
                    raise RuntimeError("Unsupported retopology attribute: "+attr)
                cmds.setAttr(node+"."+attr,value)
            count = cmds.polyEvaluate(result,face=True)
            if not count:
                raise RuntimeError("Retopology produced an empty mesh")
            # Bake only the output so later transfer/projection has stable vertex indices.
            cmds.delete(result,constructionHistory=True)
            if self.value("project","bool"):
                self.project(result,source)
        self.remember(result,"target")
        cmds.select(result,replace=True)
        self.log("Retopology complete: %s faces. Inspect face/joint loops before rigging." % count)
        self.analyze(False)

    def selected_edges(self):
        target = self.target()
        edges = cmds.filterExpand(cmds.ls(selection=True,long=True,flatten=True) or [],selectionMask=32,expand=True) or []
        if not edges:
            raise ValueError("Select edges on the working mesh")
        target_shape = shape_of(target)
        for edge in edges:
            if shape_of(edge.split(".")[0]) != target_shape:
                raise ValueError("All selected edges must belong to the working mesh")
        return edges

    def harden_edges(self):
        edges = self.selected_edges()
        with transaction("CW harden guides"):
            cmds.polySoftEdge(edges,angle=0,constructionHistory=True)
        self.log("Edges hardened. Set this working copy as Source before re-running retopology.")

    def project(self,target,source):
        cmds.transferAttributes(source,target,transferPositions=1,transferNormals=0,
                                transferUVs=0,transferColors=0,sampleSpace=0,
                                searchMethod=3,flipUVs=0,colorBorders=1)
        cmds.delete(target,constructionHistory=True)

    def project_copy(self):
        with transaction("CW projection"):
            result = snapshot(self.target(),"_projected")
            self.project(result,self.source())
        self.remember(result,"target")
        cmds.select(result)
        self.log("Projected copy created. Check thin surfaces, fingers and mouth interiors for wrong-side projection.")

    def deviation(self):
        src, dst = mesh_fn(self.source()),mesh_fn(self.target())
        points = dst.getPoints(om.MSpace.kWorld)
        stride = max(1,math.ceil(len(points)/500))
        distances = []
        for i in range(0,len(points),stride):
            close,_ = src.getClosestPoint(points[i],om.MSpace.kWorld)
            distances.append((points[i]-close).length())
        if not distances:
            raise ValueError("Empty working mesh")
        self.last_report = dict(samples=len(distances),mean_distance=sum(distances)/len(distances),
                                max_distance=max(distances),units="cm (Maya API internal units)",
                                note="One-way sampled vertex-to-surface distance, not a Hausdorff bound or topology quality score.")
        self.log(json.dumps(self.last_report,indent=2))

    def create_guide_nodes(self,spec,prefix):
        validate_spec(spec)
        group = cmds.group(empty=True,name=prefix+"_GUIDES#")
        string_attr(group,"cwGuideSpec",json.dumps(spec))
        string_attr(group,"cwPrefix",prefix)
        size = max(max(e["position"][i] for e in spec)-min(e["position"][i] for e in spec) for i in range(3))*.018
        for entry in spec:
            locator = cmds.spaceLocator(name=prefix+"_"+entry["key"]+"_guide#")[0]
            locator = cmds.parent(locator,group)[0]
            cmds.xform(locator,worldSpace=True,translation=entry["position"])
            string_attr(locator,"cwKey",entry["key"])
            sh = cmds.listRelatives(locator,shapes=True)[0]
            cmds.setAttr(sh+".localScale",size,size,size)
            cmds.setAttr(sh+".overrideEnabled",True)
            cmds.setAttr(sh+".overrideColor",14 if entry["key"].endswith("_L") or "_L_" in entry["key"] else 17)
        return group

    def create_guides(self):
        if cmds.upAxis(query=True,axis=True) != "y":
            raise ValueError("Templates require a Y-up scene; no scene axis changes are made automatically")
        spec = guide_spec(self.value("species","menu"),cmds.exactWorldBoundingBox(self.target()),
                          self.value("pairs"),self.value("spine"),self.value("tail"),self.value("digits"))
        with transaction("CW create guides"):
            group = self.create_guide_nodes(spec,safe_name(self.value("prefix","text")))
        self.remember(group,"guide")
        cmds.select(group)
        self.log("Guides created. Fit them inside the anatomy; bend knees before IK build.")

    def use_guides(self):
        node = (cmds.ls(selection=True,long=True) or [None])[0]
        if not node or not cmds.attributeQuery("cwGuideSpec",node=node,exists=True):
            raise ValueError("Select a Creature Workbench guide group")
        self.remember(node,"guide")
        self.log("Guide group selected: "+node)

    def fitted_spec(self):
        group = self.resolve("guide")
        spec = json.loads(cmds.getAttr(group+".cwGuideSpec"))
        mapping = {}
        for child in cmds.listRelatives(group,children=True,fullPath=True,type="transform") or []:
            if cmds.attributeQuery("cwKey",node=child,exists=True):
                mapping[cmds.getAttr(child+".cwKey")] = child
        for entry in spec:
            if entry["key"] not in mapping:
                raise ValueError("Missing guide: "+entry["key"])
            entry["position"] = cmds.xform(mapping[entry["key"]],query=True,worldSpace=True,translation=True)
        validate_spec(spec)
        return group,spec,mapping

    def mirror_guides(self):
        group,spec,mapping = self.fitted_spec()
        root = next(e for e in spec if e["parent"] is None)
        center = root["position"][0]
        count = 0
        with transaction("CW mirror guides"):
            for entry in spec:
                key = entry["key"]
                opposite = key.replace("_L_","_R_")
                if key.endswith("_L"):
                    opposite = key[:-2]+"_R"
                if opposite != key and opposite in mapping:
                    p = list(entry["position"]); p[0] = 2*center-p[0]
                    cmds.xform(mapping[opposite],worldSpace=True,translation=p)
                    count += 1
        self.log("Mirrored %d guides across the pelvis world-X plane." % count)

    def add_chain(self):
        group,spec,mapping = self.fitted_spec()
        selected = cmds.ls(selection=True,long=True) or []
        reverse = {v:k for k,v in mapping.items()}
        if len(selected)!=1 or selected[0] not in reverse:
            raise ValueError("Select one locator in the active guide group")
        parent = reverse[selected[0]]
        start = cmds.xform(selected[0],query=True,worldSpace=True,translation=True)
        prefix = cmds.getAttr(group+".cwPrefix")
        token = "extra_"+uuid.uuid4().hex[:6]
        bbox = cmds.exactWorldBoundingBox(self.target())
        step = max(bbox[i+3]-bbox[i] for i in range(3))*.08
        with transaction("CW add chain"):
            for i in range(self.value("chain_count")):
                key = token+"_%02d" % (i+1)
                pos = [start[0],start[1],start[2]-(i+1)*step]
                entry = dict(key=key,parent=parent,position=pos,chain=token,role="fk")
                spec.append(entry)
                loc = cmds.spaceLocator(name=prefix+"_"+key+"_guide#")[0]
                loc = cmds.parent(loc,group)[0]
                cmds.xform(loc,worldSpace=True,translation=pos)
                string_attr(loc,"cwKey",key)
                parent = key
            string_attr(group,"cwGuideSpec",json.dumps(spec))
        self.log("Extra chain created; move its locators to fit the appendage.")

    def control(self,name,joint,parent,radius,color):
        ctrl = cmds.circle(name=name,normal=(1,0,0),radius=radius,constructionHistory=False)[0]
        offset = cmds.group(ctrl,name=name+"_ZERO")
        matrix = cmds.xform(joint,query=True,worldSpace=True,matrix=True)
        cmds.xform(offset,worldSpace=True,matrix=matrix)
        cmds.parent(offset,parent)
        shape = cmds.listRelatives(ctrl,shapes=True)[0]
        cmds.setAttr(shape+".overrideEnabled",True)
        cmds.setAttr(shape+".overrideColor",color)
        for attr in ("sx","sy","sz","v"):
            cmds.setAttr(ctrl+"."+attr,lock=True,keyable=False)
        return ctrl

    def build_rig(self):
        group,spec,_ = self.fitted_spec()
        prefix = cmds.getAttr(group+".cwPrefix")+"_"+uuid.uuid4().hex[:5]
        positions = {e["key"]:e["position"] for e in spec}
        for e in spec:
            if e["parent"] and math.dist(e["position"],positions[e["parent"]]) < 1e-6:
                raise ValueError("Overlapping guides: "+e["key"])
        ik = self.value("rigmode","menu").startswith("IK")
        chains = {}
        for e in spec:
            if e["role"].startswith("ik_"):
                chains.setdefault(e["chain"],{})[e["role"]] = e["key"]
        radius = max(math.dist(e["position"],spec[0]["position"]) for e in spec)*.055
        poles = {}
        if ik:
            for chain,roles in chains.items():
                poles[chain] = pole_position(positions[roles["ik_start"]],positions[roles["ik_mid"]],
                                              positions[roles["ik_end"]],radius*6)
        with transaction("CW build rig"):
            rig = cmds.group(empty=True,name=prefix+"_RIG")
            joints_group = cmds.group(empty=True,name=prefix+"_skeleton",parent=rig)
            controls_group = cmds.group(empty=True,name=prefix+"_controls",parent=rig)
            joints,controls = {},{}
            for e in spec:
                cmds.select(clear=True)
                j = cmds.joint(name=prefix+"_"+e["key"]+"_JNT",position=e["position"],radius=radius*.3)
                j = cmds.parent(j,joints[e["parent"]] if e["parent"] else joints_group)[0]
                joints[e["key"]] = j
            # Parent-first orientation preserves child world positions in Maya.
            for e in spec:
                j = joints[e["key"]]
                if cmds.listRelatives(j,children=True,type="joint"):
                    cmds.joint(j,edit=True,orientJoint="xyz",secondaryAxisOrient="yup",zeroScaleOrient=True)
                else:
                    cmds.joint(j,edit=True,orientJoint="none",zeroScaleOrient=True)
            ikkeys = set()
            if ik:
                for roles in chains.values():
                    ikkeys.update(roles.values())
            for e in spec:
                key = e["key"]
                if key in ikkeys or e["role"] == "end":
                    continue
                parentctrl = controls.get(e["parent"],controls_group)
                ctrl = self.control(prefix+"_"+key+"_CTRL",joints[key],parentctrl,radius,14 if "_L" in key else 13 if "_R" in key else 17)
                cmds.parentConstraint(ctrl,joints[key],maintainOffset=False)
                controls[key] = ctrl
            if ik:
                for chain,roles in chains.items():
                    start,mid,end = [joints[roles[r]] for r in ("ik_start","ik_mid","ik_end")]
                    handle,_ = cmds.ikHandle(name=prefix+"_"+chain+"_IK",startJoint=start,endEffector=end,solver="ikRPsolver")
                    ctrl = self.control(prefix+"_"+chain+"_IK_CTRL",end,controls_group,radius*1.5,18)
                    cmds.parent(handle,ctrl)
                    cmds.setAttr(handle+".visibility",False)
                    cmds.orientConstraint(ctrl,end,maintainOffset=True)
                    pole = cmds.circle(name=prefix+"_"+chain+"_POLE_CTRL",radius=radius*.7,constructionHistory=False)[0]
                    cmds.xform(pole,worldSpace=True,translation=poles[chain])
                    cmds.parent(pole,controls_group)
                    cmds.poleVectorConstraint(pole,handle)
                    controls[chain+"_ik"] = ctrl
                    controls[chain+"_pole"] = pole
            string_attr(rig,"cwJoints",json.dumps(list(joints.values())))
            string_attr(rig,"cwControls",json.dumps(list(controls.values())))
            string_attr(rig,"cwVersion",VERSION)
        self.remember(rig,"rig")
        cmds.select(rig)
        self.log("Rig built: %d joints, %d controls. FK or IK mode is fixed at build; no FK/IK matching or facial rig." % (len(joints),len(controls)))

    def use_rig(self):
        selected = cmds.ls(selection=True,long=True) or []
        if len(selected)!=1 or not cmds.attributeQuery("cwJoints",node=selected[0],exists=True):
            raise ValueError("Select a generated rig group")
        self.remember(selected[0],"rig")

    def rig_items(self,attr):
        items = json.loads(cmds.getAttr(self.resolve("rig")+"."+attr))
        if not all(cmds.objExists(item) for item in items):
            raise ValueError("Rig members were renamed/deleted; stored rig membership is invalid")
        return items

    def bind_rig(self):
        target = self.target()
        if skin_of(target):
            raise ValueError("Working mesh already has skin; existing skin is not overwritten")
        joints = self.rig_items("cwJoints")
        with transaction("CW bind"):
            skin = cmds.skinCluster(joints,target,toSelectedBones=True,bindMethod=0,
                                    skinMethod=0 if self.value("skinmethod","menu")=="Classic linear" else 1,
                                    maximumInfluences=self.value("influences"),obeyMaxInfluences=True,
                                    normalizeWeights=1,name="CW_skin#")[0]
        self.log("Bound with closest-distance weighting: "+skin+". Pose-test and paint weights before production use.")

    def transfer_skin(self):
        self.require_rest()
        src,dst = self.source(),self.target()
        source_skin = skin_of(src)
        if not source_skin:
            raise ValueError("Source has no skinCluster")
        if skin_of(dst):
            raise ValueError("Working mesh already has skin; use a new unbound copy")
        influences = cmds.skinCluster(source_skin,query=True,influence=True)
        with transaction("CW transfer skin"):
            skin = cmds.skinCluster(influences,dst,toSelectedBones=True,maximumInfluences=self.value("influences"),
                                    normalizeWeights=1,skinMethod=cmds.getAttr(source_skin+".skinningMethod"))[0]
            cmds.copySkinWeights(sourceSkin=source_skin,destinationSkin=skin,noMirror=True,
                                  surfaceAssociation="closestPoint",influenceAssociation="name",normalize=True)
        self.log("Copied skin weights onto the same source influences. Original rig connections remain on the source rig.\nBlendshape deltas, per-vertex blend weights and corrective deformers are not transferred. Audit influence count.")

    def select_controls(self):
        cmds.select(self.rig_items("cwControls"),replace=True)

    def export_guides(self):
        group,spec,_ = self.fitted_spec()
        path = self.file_dialog("Export guide template","JSON (*.json)",0)
        if path:
            self.write_json(path,dict(version=1,units=cmds.currentUnit(query=True,linear=True),
                                       prefix=cmds.getAttr(group+".cwPrefix"),guides=spec))

    def import_guides(self):
        path = self.file_dialog("Import guide template","JSON (*.json)",1)
        if not path:
            return
        with open(path,encoding="utf-8") as stream:
            data = json.load(stream)
        if data.get("version") != 1:
            raise ValueError("Unsupported guide template version")
        if data.get("units") != cmds.currentUnit(query=True,linear=True):
            raise ValueError("Guide units differ from scene; convert the template or use matching scene units")
        spec = data["guides"]
        if len(spec)>2000:
            raise ValueError("Guide template exceeds 2000 joints")
        validate_spec(spec)
        with transaction("CW import guides"):
            group = self.create_guide_nodes(spec,safe_name(data.get("prefix","Creature")))
        self.remember(group,"guide")
        cmds.select(group)

    def ensure_unfold(self):
        if hasattr(cmds,"u3dUnfold"):
            return
        for plugin in ("Unfold3D","Unfold3D.mll","Unfold3D.bundle","Unfold3D.so"):
            try:
                cmds.loadPlugin(plugin,quiet=True)
                if hasattr(cmds,"u3dUnfold"):
                    return
            except RuntimeError:
                pass
        raise RuntimeError("Unfold3D is unavailable. Load it in Plug-in Manager or select Legacy Maya unfold explicitly.")

    def uvs(self):
        target = self.target()
        solver = self.value("unwrap","menu")
        if solver.startswith("Unfold3D"):
            self.ensure_unfold()
        keep = self.value("uvmode","menu").startswith("Keep")
        if keep and not mesh_fn(target).numUVs():
            raise ValueError("Working mesh needs existing UVs for Keep existing seams mode")
        with transaction("CW UV generation"):
            result = snapshot(target,"_uv")
            existing = cmds.polyUVSet(result,query=True,currentUVSet=True)[0]
            uvset = "CW_UV_"+uuid.uuid4().hex[:6]
            cmds.polyUVSet(result,create=True,uvSet=uvset)
            if keep:
                cmds.polyUVSet(result,copy=True,uvSet=existing,newUVSet=uvset)
            cmds.polyUVSet(result,currentUVSet=True,uvSet=uvset)
            if not keep:
                cmds.polyAutoProjection(result+".f[*]",planes=int(self.value("planes","menu")),
                                        layoutMethod=0,optimize=1,scaleMode=1,
                                        percentageSpace=self.value("padding","float"),uvSetName=uvset)
            cmds.select(result+".map[*]",replace=True)
            if solver.startswith("Unfold3D"):
                # Autodesk directs scripts to query help in-host; no undocumented flags assumed.
                cmds.u3dUnfold(result+".map[*]")
            elif solver.startswith("Legacy"):
                cmds.unfold(result+".map[*]",iterations=self.value("iterations"),
                            stoppingThreshold=.001,pinUvBorder=False,useScale=False)
            cmds.polyLayoutUV(result+".f[*]",layout=2,layoutMethod=1,
                              percentageSpace=self.value("padding","float"),
                              rotateForBestFit={"Free":2,"90 degrees":1,"None":0}[self.value("rotation","menu")],
                              scale=1,separate=0,flipReversed=False,uvSetName=uvset)
            tile = self.value("tile")-1001
            if tile:
                cmds.polyEditUV(result+".map[*]",relative=True,uValue=tile%10,vValue=tile//10)
            cmds.delete(result,constructionHistory=True)
        self.remember(result,"target")
        cmds.select(result)
        self.log("UV copy created. This geometry snapshot is unskinned; UV before binding or transfer skin afterward.")
        self.analyze_uv()

    def cut_seams(self):
        edges = self.selected_edges()
        with transaction("CW cut seams"):
            cmds.polyMapCut(edges,constructionHistory=True)
        self.log("Selected UV edges cut on the working mesh; run Keep existing seams next.")

    def analyze_uv(self):
        self.last_report = uv_report(self.target())
        self.log(json.dumps(self.last_report,indent=2))

    def audit_skin(self):
        mesh = self.target()
        skin = skin_of(mesh)
        if not skin:
            raise ValueError("Working mesh is not skinned")
        import maya.api.OpenMayaAnim as oma
        selection = om.MSelectionList(); selection.add(skin)
        fn = oma.MFnSkinCluster(selection.getDependNode(0))
        meshfn = mesh_fn(mesh)
        compfn = om.MFnSingleIndexedComponent()
        comp = compfn.create(om.MFn.kMeshVertComponent)
        compfn.addElements(range(meshfn.numVertices))
        weights,count = fn.getWeights(meshfn.dagPath(),comp)
        unweighted,not_normalized,over_limit = [],[],[]
        limit = self.value("influences")
        for i in range(meshfn.numVertices):
            values = weights[i*count:(i+1)*count]
            total = sum(values)
            if total < 1e-8: unweighted.append(i)
            if abs(total-1)>1e-4: not_normalized.append(i)
            if sum(v>1e-5 for v in values)>limit: over_limit.append(i)
        self.last_report = dict(mesh=mesh,skin=skin,vertices=meshfn.numVertices,influences=count,
                                unweighted_count=len(unweighted),unnormalized_count=len(not_normalized),
                                over_influence_limit_count=len(over_limit),limit=limit,
                                unweighted_first_100=unweighted[:100],
                                note="Numerical audit only. Does not measure bending quality, volume loss or weight leakage.")
        self.log(json.dumps(self.last_report,indent=2))

    def detect(self):
        modules = cmds.moduleInfo(listModules=True) or []
        plugins = cmds.pluginInfo(query=True,listPlugins=True) or []
        optional = {}
        for name in ("mgear","ngSkinTools2","QuadRemesher"):
            try:
                optional[name] = importlib.util.find_spec(name) is not None
            except (ImportError,ValueError):
                optional[name] = False
        self.last_report = dict(maya=cmds.about(version=True),modules=modules,loaded_plugins=plugins,
                                python_modules=optional,polyRetopo=hasattr(cmds,"polyRetopo"),
                                note="Detection is not a license check; MEL-only packages may appear only in the module list.")
        self.log(json.dumps(self.last_report,indent=2))

    def open_ngskin(self):
        try:
            import ngSkinTools2
        except ImportError:
            raise RuntimeError("Install ngSkinTools 2 for this Maya version first")
        ngSkinTools2.open_ui()

    def export_obj(self):
        target = self.target()
        path = self.file_dialog("Export working OBJ","OBJ (*.obj)",0)
        if not path: return
        cmds.loadPlugin("objExport",quiet=True)
        selected = cmds.ls(selection=True,long=True) or []
        try:
            cmds.select(target,replace=True)
            cmds.file(path,force=True,options="groups=1;ptgroups=1;materials=1;smoothing=1;normals=1",
                      type="OBJexport",exportSelected=True)
        finally:
            cmds.select(selected,replace=True) if selected else cmds.select(clear=True)
        self.log("Exported "+path)

    def import_obj(self):
        path = self.file_dialog("Import processed OBJ","OBJ (*.obj)",1)
        if not path: return
        with transaction("CW import OBJ"):
            nodes = cmds.file(path,i=True,type="OBJ",ignoreVersion=True,
                              namespace="CW_import_"+uuid.uuid4().hex[:5],returnNewNodes=True)
        meshes = cmds.ls(nodes,type="mesh",long=True) or []
        if len(meshes)==1:
            mesh = cmds.listRelatives(meshes[0],parent=True,fullPath=True)[0]
            self.remember(mesh,"target")
            cmds.select(mesh)
        self.log("Imported separate objects; verify scale, topology and UVs. %d mesh shapes." % len(meshes))

    def file_dialog(self,caption,filter_,mode):
        paths = cmds.fileDialog2(caption=caption,fileFilter=filter_,fileMode=mode,dialogStyle=2)
        return paths[0] if paths else None

    def write_json(self,path,data):
        with open(path,"w",encoding="utf-8") as stream:
            json.dump(data,stream,indent=2,allow_nan=False)
        self.log("Saved "+path)

    def save_report(self):
        if not self.last_report: raise ValueError("Run an analysis first")
        path = self.file_dialog("Save report","JSON (*.json)",0)
        if path: self.write_json(path,self.last_report)

    def settings_schema(self):
        return {**{k:"int" for k in ("faces","tolerance","pairs","spine","tail","digits","chain_count","influences","iterations","tile")},
                **{k:"int" for k in ("fit_steps","fit_band","patch_segments","patch_rings")},
                **{k:"float" for k in ("regularity","uniformity","anisotropy","padding","fit_distance")},
                **{k:"bool" for k in ("hard","project")},
                **{k:"menu" for k in ("species","rigmode","skinmethod","uvmode","planes","unwrap","rotation")},"prefix":"text"}

    def save_settings(self):
        path = self.file_dialog("Save settings","JSON (*.json)",0)
        if path: self.write_json(path,{"version":1,"settings":{k:self.value(k,t) for k,t in self.settings_schema().items()}})

    def load_settings(self):
        path = self.file_dialog("Load settings","JSON (*.json)",1)
        if not path: return
        with open(path,encoding="utf-8") as stream: data = json.load(stream)
        if data.get("version")!=1: raise ValueError("Unsupported settings version")
        controls = {"int":cmds.intSliderGrp,"float":cmds.floatSliderGrp,"bool":cmds.checkBox,
                    "menu":cmds.optionMenu,"text":cmds.textField}
        # Validate all fields before changing the UI; JSON is data, never executed.
        for key,kind in self.settings_schema().items():
            if key not in data["settings"]: continue
            value = data["settings"][key]
            if kind in ("int","float"):
                if isinstance(value,bool) or not isinstance(value,(int,float)) or not math.isfinite(value):
                    raise ValueError("Invalid numeric setting: "+key)
                lo=controls[kind](self.ui[key],query=True,fieldMinValue=True)
                hi=controls[kind](self.ui[key],query=True,fieldMaxValue=True)
                if value<lo or value>hi or (kind=="int" and int(value)!=value):
                    raise ValueError("Setting outside range: "+key)
            elif kind=="bool" and not isinstance(value,bool): raise ValueError("Invalid boolean: "+key)
            elif kind in ("menu","text") and not isinstance(value,str): raise ValueError("Invalid text: "+key)
            if kind=="menu":
                options = cmds.optionMenu(self.ui[key],query=True,itemListLong=True) or []
                if value not in [cmds.menuItem(item,query=True,label=True) for item in options]:
                    raise ValueError("Unknown menu choice: "+key)
        for key,kind in self.settings_schema().items():
            if key in data["settings"]:
                controls[kind](self.ui[key],edit=True,**({"text":data["settings"][key]} if kind=="text" else {"value":data["settings"][key]}))
        self.log("Settings loaded; rest-pose verification and scene-object assignments are not imported.")


def show():
    global INSTANCE
    INSTANCE = Workbench()
    INSTANCE.show()
    return INSTANCE




